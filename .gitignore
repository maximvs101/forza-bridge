# Bytecode Python
__pycache__/
*.py[cod]

# Etat local de l'interface (ports, selection de canaux) : regenere avec les
# valeurs par defaut au premier lancement.
config.json

# Ordinaux de vehicules rencontres et absents de la table : trace locale,
# propre a la partie jouee.
car_ordinals_unknown.json
# Configurations jetables des tests d'interface : supprimees en tearDown,
# mais un test interrompu en laisse une derriere lui.
tests/_config_*.json
tests/_inconnus_test.json
# Fichiers temporaires d'ecriture atomique
*.json.tmp
